# Environment variable example
# Copy to .env file and enter values when actually using

# Web Server Port (default: 9999)
PORT=9999

# Provider API keys
# Z.ai (GLM) - get your API key from https://z.ai
ZAI_API_KEY=your_api_key_here

# Base URL for the web server (default: /quota)
BASE_URL=/quota

# Additional reverse-proxy paths to accept (comma-separated)
# Example: keep the old /zai-quota path working: BASE_URL_ALIASES=/zai-quota
BASE_URL_ALIASES=
